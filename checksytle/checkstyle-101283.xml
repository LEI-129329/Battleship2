<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="TreeWalker">
        <!-- Regra para nomes de constantes: UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <!-- Expressão regular: apenas letras maiúsculas, números e underscores -->
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
            <message key="name.invalidPattern" value="O nome da constante ''{0}'' deve estar em UPPER_SNAKE_CASE (ex: MAX_SHIPS)."/>
        </module>
    </module>
</module>